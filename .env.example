# Copy to .env and fill in. Never commit .env.

# ---- behaviour
STUB_MODE=true
LOG_LEVEL=INFO

# ---- Neo4j (public knowledge, written by C2 only)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# ---- PostgreSQL (private citizen data)
POSTGRES_USER=helaguide
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=helaguide
DATABASE_URL=postgresql://helaguide:change-me-postgres@postgres:5432/helaguide

# ---- service locations inside the docker network
C1_URL=http://c1-intent:8001
C2_URL=http://c2-knowledge-graph:8002
C3_URL=http://c3-trust:8003
C4_URL=http://c4-presentation:8004

# ---- frontend
FRONTEND_ORIGIN=http://localhost:5173
VITE_GATEWAY_URL=http://localhost:8000

# ---- language model keys (C1 synthetic data, C2 extraction). Leave blank in git.
LLM_API_KEY=
