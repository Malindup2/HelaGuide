 "openapi": {
  "paths": {
   "/v1/intent": {
    "post": {
     "tags": [
      "intent"
     ],
     "summary": "Resolve Intent",
     "description": "Raw citizen text in, identified service out.",
     "operationId": "resolve_intent_v1_intent_post",
     "requestBody": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/UtteranceRequest"
        }
       }
      },
      "required": true
     },
     "responses": {
      "200": {
       "description": "Successful Response",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Intent"
         }
        }
       }
      },
      "422": {
       "description": "Validation Error",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/HTTPValidationError"
         }
        }
       }
      }
     }
    }
   },
   "/v1/intent/details": {
    "post": {
     "tags": [
      "intent",
      "c1-internal"
     ],
     "summary": "Resolve Intent Details",
     "description": "C1-only: the full analysis (internal intent, route, slots, language tags). Not part of the contract.\nShares sessions with /v1/intent. bot_text is the bot's last question, if any.",
     "operationId": "resolve_intent_details_v1_intent_details_post",
     "requestBody": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DetailsRequest"
        }
       }
      },
      "required": true
     },
     "responses": {
      "200": {
       "description": "Successful Response",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/IntentDetails"
         }
        }
       }
      },
      "422": {
       "description": "Validation Error",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/HTTPValidationError"
         }
        }
       }
      }
     }
    }
   }
  },
  "schemas": {
   "DetailsRequest": {
    "properties": {
     "session_id": {
      "type": "string",
      "title": "Session Id"
     },
     "text": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1,
      "title": "Text"
     },
     "bot_text": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 2000
       },
       {
        "type": "null"
       }
      ],
      "title": "Bot Text"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "session_id",
     "text"
    ],
    "title": "DetailsRequest",
    "description": "UtteranceRequest plus the bot's last question, which helps the tracker read short answers."
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Intent": {
    "properties": {
     "session_id": {
      "type": "string",
      "title": "Session Id"
     },
     "turn_id": {
      "type": "integer",
      "minimum": 0.0,
      "title": "Turn Id"
     },
     "language": {
      "type": "string",
      "enum": [
       "si",
       "en",
       "ta",
       "mixed"
      ],
      "title": "Language"
     },
     "intent": {
      "type": "string",
      "enum": [
       "apply_service",
       "service_info",
       "check_requirements",
       "unknown"
      ],
      "title": "Intent"
     },
     "entities": {
      "$ref": "#/components/schemas/IntentEntities"
     },
     "confidence": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "session_id",
     "turn_id",
     "language",
     "intent",
     "entities",
     "confidence"
    ],
    "title": "Intent"
   },
   "IntentDetails": {
    "properties": {
     "session_id": {
      "type": "string",
      "title": "Session Id"
     },
     "turn_id": {
      "type": "integer",
      "minimum": 0.0,
      "title": "Turn Id"
     },
     "state_version": {
      "type": "integer",
      "minimum": 0.0,
      "title": "State Version",
      "description": "Goes up when the active request's intent, slots, conditions or pending variant change; ask C2 again when it differs from the last one sent"
     },
     "internal_intent": {
      "type": "string",
      "title": "Internal Intent",
      "description": "One of the 12 schema-v1.1 intents, or unknown"
     },
     "intent_model_output": {
      "type": "string",
      "title": "Intent Model Output",
      "description": "What the classifier predicted before the confidence check"
     },
     "confidence": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence"
     },
     "intent_source": {
      "type": "string",
      "enum": [
       "model",
       "keyword_fallback",
       "previous_topic",
       "active_intent",
       "current_message_switch",
       "pending_resume",
       "variant_answer",
       "service_keyword",
       "greeting",
       "unknown"
      ],
      "title": "Intent Source"
     },
     "active_intent": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Active Intent",
      "description": "The core intent the conversation is about; kept across turns unless the user clearly switches service. None until one is confident"
     },
     "intent_locked": {
      "type": "boolean",
      "title": "Intent Locked",
      "description": "True when this turn kept active_intent over the model's prediction"
     },
     "ready": {
      "type": "boolean",
      "title": "Ready",
      "description": "All slots of active_intent are filled and confirmed; the request can go to orchestration"
     },
     "assumed_slots": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Assumed Slots",
      "description": "Slots carried over from an earlier request that the citizen has not confirmed yet (only district); the bot asks before using them"
     },
     "variant_pending": {
      "type": "boolean",
      "title": "Variant Pending",
      "description": "The citizen named the service but not which kind (\"i need a NIC\"); internal_intent is provisional and the reply asks",
      "default": false
     },
     "reply": {
      "type": "string",
      "minLength": 1,
      "title": "Reply",
      "description": "What the bot says next: the next slot question, a confirmation, a clarifying question or a fallback"
     },
     "completed_requests": {
      "items": {
       "$ref": "#/components/schemas/RequestSummary"
      },
      "type": "array",
      "title": "Completed Requests",
      "description": "Requests finished earlier in the conversation (all slots filled when the citizen moved on)"
     },
     "pending_requests": {
      "items": {
       "$ref": "#/components/schemas/RequestSummary"
      },
      "type": "array",
      "title": "Pending Requests",
      "description": "Requests left unfinished by a switch; the bot offers to finish them once the active one is ready"
     },
     "route": {
      "type": "string",
      "enum": [
       "orchestration",
       "trust_verification",
       "fallback",
       "none"
      ],
      "title": "Route"
     },
     "slots": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "title": "Slots"
     },
     "conditions": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "boolean"
        }
       ]
      },
      "type": "object",
      "title": "Conditions",
      "description": "Facts about the applicant that are not slots, kept only when said and never asked for: applicant_age (int), applicant_minor (bool). C1 does not decide what they imply; C2 does"
     },
     "missing_slots": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Missing Slots"
     },
     "language": {
      "type": "string",
      "enum": [
       "si",
       "en",
       "ta",
       "mixed"
      ],
      "title": "Language"
     },
     "language_tags": {
      "items": {
       "$ref": "#/components/schemas/LanguageTag"
      },
      "type": "array",
      "title": "Language Tags"
     },
     "code_switched": {
      "type": "boolean",
      "title": "Code Switched"
     },
     "latency_ms": {
      "type": "number",
      "minimum": 0.0,
      "title": "Latency Ms"
     },
     "context_strategy": {
      "type": "string",
      "title": "Context Strategy",
      "description": "How the intent model's input is built: window_3 = the last 3 user messages (the deployed setting, Observation 8)"
     },
     "context_tokens": {
      "type": "integer",
      "minimum": 0.0,
      "title": "Context Tokens",
      "description": "Tokens the intent model read this turn: the whole context window including the current message, XLM-R tokenizer with <s> and </s>, before truncation; 0 when the model did not run (a greeting)"
     },
     "intent": {
      "$ref": "#/components/schemas/Intent",
      "description": "The same projection /v1/intent returns"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "session_id",
     "turn_id",
     "state_version",
     "internal_intent",
     "intent_model_output",
     "confidence",
     "intent_source",
     "active_intent",
     "intent_locked",
     "ready",
     "assumed_slots",
     "reply",
     "completed_requests",
     "pending_requests",
     "route",
     "slots",
     "missing_slots",
     "language",
     "language_tags",
     "code_switched",
     "latency_ms",
     "context_strategy",
     "context_tokens",
     "intent"
    ],
    "title": "IntentDetails"
   },
   "IntentEntities": {
    "properties": {
     "service_id": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^svc:[a-z0-9_]+$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Service Id"
     },
     "district": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "District"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "title": "IntentEntities"
   },
   "LanguageTag": {
    "properties": {
     "word": {
      "type": "string",
      "title": "Word"
     },
     "tag": {
      "type": "string",
      "title": "Tag",
      "description": "SI, EN, MIXED, NE or OTHER (O for words past the model's max length)"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "word",
     "tag"
    ],
    "title": "LanguageTag"
   },
   "RequestSummary": {
    "properties": {
     "intent": {
      "type": "string",
      "title": "Intent"
     },
     "service_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Service Id"
     },
     "slots": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "title": "Slots"
     },
     "conditions": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "boolean"
        }
       ]
      },
      "type": "object",
      "title": "Conditions"
     },
     "variant_pending": {
      "type": "boolean",
      "title": "Variant Pending",
      "default": false
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "intent",
     "service_id",
     "slots"
    ],
    "title": "RequestSummary",
    "description": "A service request in the conversation other than the active one."
   },
   "UtteranceRequest": {
    "properties": {
     "session_id": {
      "type": "string",
      "title": "Session Id"
     },
     "text": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1,
      "title": "Text"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "session_id",
     "text"
    ],
    "title": "UtteranceRequest",
    "description": "What the frontend sends to the gateway, and the gateway to C1."
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}
