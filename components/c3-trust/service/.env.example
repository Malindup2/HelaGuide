# Copy this file to  .env  (same folder) and fill it in. Never commit .env (git ignores it).

# --- C3's own database (docker-compose.c3.yml) ------------------------------------------
C3_DATABASE_URL=postgresql://c3:c3pass@localhost:5433/c3_pp1

# --- the pretrained embedding model (free, runs on your computer) -----------------------
C3_EMBEDDING_BACKEND=sbert
C3_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# --- translation with Gemini (only needed to REFRESH the translation cache) --------------
C3_GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
C3_GEMINI_MODEL=gemini-2.5-flash
# Keep this false on demo day: the demo then needs no key and no internet.
C3_ALLOW_LIVE_LLM=false

# --- grounding thresholds: paste the lines printed by  python -m app.cli.tune_grounding --
# C3_TAU_F=0.55
# C3_DELTA_F=0.06
# C3_TAU_MISS_COS=0.35
