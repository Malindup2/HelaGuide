{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helaguide.local/contracts/v1/correction.schema.json",
  "title": "Correction",
  "description": "C3 -> C2. A verified correction. C3 never writes to the graph; C2 applies this as a content-change event.",
  "type": "object",
  "required": [
    "correction_id",
    "fact_id",
    "proposed_value",
    "confidence",
    "report_count",
    "verified_at"
  ],
  "additionalProperties": false,
  "properties": {
    "correction_id": {
      "type": "string"
    },
    "fact_id": {
      "type": "string",
      "pattern": "^svc:[a-z0-9_]+:[a-z0-9_]+(:[a-z0-9_]+)?$"
    },
    "proposed_value": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "report_count": {
      "type": "integer",
      "minimum": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
