{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helaguide.local/contracts/v1/plan.schema.json",
  "title": "Plan",
  "description": "C2 -> C4. A dependency-ordered procedure. Fields, never prose, so C4 can adapt presentation.",
  "type": "object",
  "required": [
    "plan_id",
    "requested_service_id",
    "generated_at",
    "steps",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "requested_service_id": {
      "type": "string",
      "pattern": "^svc:[a-z0-9_]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "service_id",
          "name",
          "agency",
          "fee",
          "documents",
          "depends_on"
        ],
        "additionalProperties": false,
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "service_id": {
            "type": "string",
            "pattern": "^svc:[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "agency": {
            "type": "string"
          },
          "fee": {
            "type": "object",
            "required": [
              "value",
              "currency",
              "fact_id"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string"
              },
              "fact_id": {
                "type": "string",
                "pattern": "^svc:[a-z0-9_]+:[a-z0-9_]+(:[a-z0-9_]+)?$"
              }
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "fact_id"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "fact_id": {
                  "type": "string",
                  "pattern": "^svc:[a-z0-9_]+:[a-z0-9_]+(:[a-z0-9_]+)?$"
                }
              }
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^svc:[a-z0-9_]+$"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Keyed by fact_id.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source_url",
          "retrieved_at"
        ],
        "additionalProperties": false,
        "properties": {
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
