{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helaguide.local/contracts/v1/fact.schema.json",
  "title": "Fact",
  "description": "One versioned fact about a government service. Every fact moved between components carries its identity and provenance.",
  "type": "object",
  "required": [
    "fact_id",
    "service_id",
    "predicate",
    "value",
    "source_url",
    "retrieved_at",
    "valid_from",
    "valid_to"
  ],
  "additionalProperties": false,
  "properties": {
    "fact_id": {
      "type": "string",
      "pattern": "^svc:[a-z0-9_]+:[a-z0-9_]+(:[a-z0-9_]+)?$",
      "description": "Stable identity derived from graph position, never from the value. See contracts/naming.md."
    },
    "service_id": {
      "type": "string",
      "pattern": "^svc:[a-z0-9_]+$"
    },
    "predicate": {
      "type": "string",
      "enum": [
        "fee",
        "document",
        "agency",
        "prerequisite",
        "processing_time",
        "eligibility"
      ]
    },
    "value": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ],
      "description": "e.g. LKR, days. Null when not applicable."
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Null while this is the current value."
    },
    "history": {
      "type": "array",
      "description": "Superseded values, newest first. Present on GET /v1/facts/{fact_id}.",
      "items": {
        "type": "object",
        "required": [
          "value",
          "valid_from",
          "valid_to"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_to": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
